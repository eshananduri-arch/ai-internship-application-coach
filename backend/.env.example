APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8010
# Dedicated restricted login URLs; never use the postgres administrator in the app.
DATABASE_URL=
WORKER_DATABASE_URL=
OPERATOR_DATABASE_URL=
# Relative to backend/, used by API, worker and management pools. Public CA only.
DB_SSLROOTCERT=certs/supabase-root-2021.crt
# Generate with: python scripts/create_local_config.py
SESSION_SIGNING_KEY=
RESUME_ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
ADMIN_TOKEN=
COOKIE_SECURE=false
# Add after the production n8n API workflow is created. No synthetic fallback.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_TIMEOUT_SECONDS=150
N8N_IDEMPOTENT=false
MAX_WORKER_CONCURRENCY=2
THREAD_IDLE_SECONDS=10
MAX_UPLOAD_BYTES=5242880
